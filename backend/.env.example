# Run from backend: python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
# .env is read from the backend directory. Never commit your real API key.
WORKSHOP_DATA_DIR=./data
WORKSHOP_GROQ_API_KEY=
WORKSHOP_GROQ_MODEL=llama-3.3-70b-versatile
WORKSHOP_GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Scraping is disabled until exact hostnames are explicitly allowed.
WORKSHOP_ALLOWED_HOSTS=[]
WORKSHOP_TRUSTED_HOSTS=["localhost","127.0.0.1","[::1]"]
WORKSHOP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
WORKSHOP_MAX_UPLOAD_BYTES=8388608
WORKSHOP_MAX_REQUEST_BYTES=12582912
WORKSHOP_MAX_HTML_BYTES=2097152
WORKSHOP_NETWORK_TIMEOUT=20
WORKSHOP_MAX_DOCUMENT_PAGES=200
WORKSHOP_MAX_DOCUMENT_CHUNKS=2048
