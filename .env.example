# Optional: install python-dotenv to load a repo-root .env automatically.
# Or set these in the server process environment. Never put keys in frontend code.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Hugging Face HTTP timeouts (seconds) for the first embedding download.
HF_HUB_ETAG_TIMEOUT=20
HF_HUB_DOWNLOAD_TIMEOUT=30
# For an already cached model and no Hugging Face network calls:
# HF_HUB_OFFLINE=1
